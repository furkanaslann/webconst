---
import BaseLayout from '../presentation/layouts/BaseLayout.astro';
import Section from '../presentation/components/ui/Section.astro';
import FAQ from '../presentation/components/FAQ.astro';
import type { FAQItem } from '../presentation/components/FAQ.astro';

const faqs: FAQItem[] = [
  {
    id: '1',
    question: 'Bina güçlendirme nedir ve neden gereklidir?',
    answer: 'Bina güçlendirme, mevcut binaların deprem yönetmeliğine uygun hale getirilmesi işlemidir. Türkiye\'de deprem riski nedeniyle binaların taşıyıcı sistemlerinin güçlendirilmesi hem can güvenliği hem de yasal zorunluluk açısından gereklidir. 1999\'dan önce inşa edilmiş binalar için özellikle önemlidir.',
    category: 'Güçlendirme',
  },
  {
    id: '2',
    question: 'Su yalıtım uygulamaları nerede yapılır?',
    answer: 'Su yalıtım uygulaması temeller, teraslar, balkonlar, çatılar, havuzlar, ıslak zeminler (banyo, mutfak) ve perde duvarlarda yapılır. Su sızmasını önlemek ve binanın ömrünü uzatmak için kritik öneme sahiptir.',
    category: 'Su Yalıtım',
  },
  {
    id: '3',
    question: 'Epoxy zemin kaplama nedir?',
    answer: 'Epoxy zemin kaplama, reçine bazlı iki bileşenli bir kaplama sistemidir. Endüstriyel alanlar, fabrikalar, garajlar, depolar ve ticari alanlarda kullanılır. Çizilme, kimyasal etkilere ve aşınmaya karşı dayanıklıdır. Hijyenik, kolay temizlenebilir ve estetik bir zemin çözümüdür.',
    category: 'Zemin Kaplama',
  },
  {
    id: '4',
    question: 'Güçlendirme projesi ne kadar sürer?',
    answer: 'Proje süresi binanın büyüklüğüne, mevcut durumuna ve güçlendirme yöntemine göre değişmektedir. Küçük ölçekli bir bina için 2-3 ay, büyük ölçekli projelerde 6-12 ay sürebilmektedir. Detaylı inceleme sonrasında net süre verilebilir.',
    category: 'Güçlendirme',
  },
  {
    id: '5',
    question: 'Yapı kimyasalları nerede kullanılır?',
    answer: 'Yapı kimyasalları inşaatın birçok aşamasında kullanılır: silan/siloksan su itici olarak dış cephelerde, sızdırmazlık malzemeleri derzlerde, yapıştırıcılar seramik uygulamalarında, katkı maddeleri beton dayanımını artırmak için kullanılır.',
    category: 'Yapı Kimyasalları',
  },
  {
    id: '6',
    question: 'Keşif ve teklif hizmeti ücretli mi?',
    answer: 'Hayır, Kayseri ve çevresinde sunduğumuz keşif ve teklif hizmeti tamamen ücretsizdir. Uzman ekibimiz projenizi yerinde inceleyerek size detaylı rapor ve teklif sunar.',
    category: 'Genel',
  },
  {
    id: '7',
    question: 'Zemin kaplama uygulaması ne kadar sürede kurur?',
    answer: 'Kullanılan malzemeye ve ortam sıcaklığına göre değişmekle birlikte, epoxy zemin kaplamalar genellikle 24-48 saat içinde yürünebilir hale gelir. Tam sertleşme ve kimyasal dayanıklılık ise 7 gün içinde gerçekleşir.',
    category: 'Zemin Kaplama',
  },
  {
    id: '8',
    question: 'Hizmet verdiğiniz bölgeler neresidir?',
    answer: 'Merkezimiz Kayseri\'de olup, Kayseri ili genelinde ve çevre illerde (Nevşehir, Yozgat, Sivas vb.) hizmet veriyoruz. Projenin büyüklüğüne göre diğer illere de hizmet sunabiliyoruz.',
    category: 'Genel',
  },
  {
    id: '9',
    question: 'Su yalıtım uygulamasının garantisi var mı?',
    answer: 'Evet, kullandığımız malzemeler ve uygulama hizmetleri firmamız tarafından garantilidir. Malzeme ve uygulama türüne göre garanti süresi değişmektedir. Detaylı bilgi teklif aşamasında paylaşılmaktadır.',
    category: 'Su Yalıtım',
  },
  {
    id: '10',
    question: 'Güçlendirme için neler gereklidir?',
    answer: 'Öncelikle binanın rölev ölçüsü, statik projesi ve varsa zemin etüt raporları gereklidir. Bu belgelerle birlikte binanın mevcut durumu incelenir, laboratuvar testleri yapılır ve uygun güçlendirme projesi hazırlanır.',
    category: 'Güçlendirme',
  },
  {
    id: '11',
    question: 'Kayseri mantolama fiyatları neye göre belirlenir?',
    answer: 'Kayseri’de mantolama fiyatları bina cephesi metrajı, iskele ihtiyacı, seçilen yalıtım malzemesi, kat yüksekliği ve detay işçilik kalemlerine göre belirlenir. Net fiyatlandırma için yerinde keşif ve mevcut cephe analizi yapılması gerekir.',
    category: 'Mantolama & Çatı',
  },
  {
    id: '12',
    question: 'Çatı yenileme ne kadar sürer, su yalıtımı dahil mi?',
    answer: 'Çatı yenileme süresi çatının büyüklüğü, hasar durumu ve hava koşullarına göre değişir. Profesyonel uygulamada kaplama yenileme ile birlikte su yalıtımı, detay sızdırmazlık ve gerekli havalandırma kontrolleri birlikte planlanır.',
    category: 'Mantolama & Çatı',
  },
  {
    id: '13',
    question: 'Kayseri anahtar teslim tadilat hizmeti neleri kapsar?',
    answer: 'Anahtar teslim tadilat hizmeti; keşif, ihtiyaç analizi, uygulama planı, malzeme seçimi, saha koordinasyonu, kalite kontrol ve teslim adımlarını kapsar. Tek ekip yönetimi sayesinde süreç daha kontrollü ve zaman planına uygun ilerler.',
    category: 'İç Mekan Uygulamaları',
  },
  {
    id: '14',
    question: 'İç cephe boya ve alçıpan işleri kaç günde tamamlanır?',
    answer: 'Tamamlanma süresi uygulama alanının büyüklüğü, yüzey hazırlığı, kat sayısı ve kuruma koşullarına göre değişir. Boya ve alçıpan işlerinde net süre, keşif sonrası oluşturulan iş programı ile gün bazlı planlanır.',
    category: 'İç Mekan Uygulamaları',
  },
  {
    id: '15',
    question: 'Banyo ve mutfak gibi alanlarda hangi alçıpan tercih edilmelidir?',
    answer: 'Nemli hacimlerde neme dayanımlı levhalar tercih edilmelidir. Sürekli su teması bulunan bölgelerde ise uygun su yalıtım detayı ve doğru alt sistem çözümü birlikte planlanarak uygulama ömrü artırılır.',
    category: 'İç Mekan Uygulamaları',
  },
  {
    id: '16',
    question: 'Anahtar teslim proje yönetiminde süre ve bütçe nasıl kontrol edilir?',
    answer: 'Süre ve bütçe kontrolü; başlangıç keşfi, iş kırılımı, haftalık ilerleme takibi ve onaylı değişiklik yönetimi ile yapılır. Bu sistem, maliyet sapmalarını azaltır ve projenin planlanan tarihte teslim edilmesini kolaylaştırır.',
    category: 'Anahtar Teslim',
  },
];

const faqCategories = [
  { id: 'genel', key: 'Genel', title: 'Genel Sorular', helper: 'Keşif, fiyatlandırma ve hizmet bölgeleri' },
  { id: 'guclendirme', key: 'Güçlendirme', title: 'Güçlendirme Çalışmaları', helper: 'Deprem dayanımı, süreç ve gerekli belgeler' },
  { id: 'su-yalitim', key: 'Su Yalıtım', title: 'Su Yalıtım Hizmetleri', helper: 'Uygulama alanları, garanti ve teknik detaylar' },
  { id: 'zemin-kaplama', key: 'Zemin Kaplama', title: 'Zemin Kaplama Sistemleri', helper: 'Epoxy çözümler, kuruma süresi ve kullanım alanları' },
  { id: 'yapi-kimyasallari', key: 'Yapı Kimyasalları', title: 'Yapı Kimyasalları', helper: 'Malzeme tipleri ve doğru kullanım senaryoları' },
  { id: 'mantolama-cati', key: 'Mantolama & Çatı', title: 'Mantolama ve Çatı Sistemleri', helper: 'Isı verimliliği, havalandırma ve çatı yenileme detayları' },
  { id: 'ic-mekan-uygulamalari', key: 'İç Mekan Uygulamaları', title: 'İç Mekan Uygulamaları', helper: 'Tadilat, boya ve alçıpan uygulama soruları' },
  { id: 'anahtar-teslim', key: 'Anahtar Teslim', title: 'Anahtar Teslim Proje Yönetimi', helper: 'Kapsam, koordinasyon ve teslim süreci' },
];
---

<BaseLayout
  title="Sıkça Sorulan Sorular - Process"
  description="Kayseri mantolama, çatı yenileme, iç cephe boya, alçıpan ve anahtar teslim tadilat hizmetleri hakkında sıkça sorulan sorular ve net cevaplar."
>
  <Section bgColor="gray">
    <div class="py-20">
      <div class="max-w-5xl mx-auto text-center mb-12 animate-on-scroll px-4">
        <p class="inline-flex items-center justify-center rounded-full border border-accent-200 bg-accent-50 px-4 py-1 text-sm font-semibold text-accent-700 mb-5">
          Teknik Bilgi Merkezi
        </p>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-5 tracking-tight">
          Sıkça Sorulan Sorular
        </h1>
        <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
          Kayseri’de mantolama, çatı yenileme, iç mekan uygulamaları ve anahtar teslim tadilat süreçleri hakkında en çok sorulan soruları
          tek bir sayfada topladık.
        </p>
      </div>

      <div class="max-w-5xl mx-auto px-4 mb-14">
        <nav class="animate-on-scroll" aria-label="SSS Kategori Gezintisi">
          <ul class="flex flex-wrap justify-center gap-3">
            {faqCategories.map((category) => (
              <li>
                <a
                  href={`#${category.id}`}
                  class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:border-accent-300 hover:text-accent-700 transition-colors duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2"
                >
                  <span>{category.title}</span>
                  <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">
                    {faqs.filter((faq) => faq.category === category.key).length}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <div class="max-w-5xl mx-auto px-4">
        {faqCategories.map((category) => (
          <section id={category.id} class="mb-12 faq-category scroll-mt-32">
            <div class="mb-6 animate-on-scroll">
              <h2 class="text-2xl font-bold text-gray-900">{category.title}</h2>
              <p class="text-gray-600 mt-2">{category.helper}</p>
            </div>
            <FAQ faqs={faqs.filter((faq) => faq.category === category.key)} />
          </section>
        ))}
      </div>
    </div>
  </Section>

  <Section bgColor="white">
    <div class="py-16 cta-section px-4">
      <div class="max-w-5xl mx-auto rounded-2xl border border-accent-100 bg-accent-50/70 p-8 md:p-10 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 animate-on-scroll">
          Sorunuzun Cevabını Bulamadınız mı?
        </h2>
        <p class="text-gray-700 mb-8 max-w-2xl mx-auto leading-relaxed animate-on-scroll" style="transition-delay: 100ms">
          Projenize uygun en doğru çözümü birlikte belirlemek için ücretsiz keşif ve danışmanlık
          talep edebilirsiniz.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a
            href="/iletisim"
            class="inline-flex items-center justify-center bg-accent-500 text-white px-8 py-3 rounded-lg font-semibold hover:bg-accent-600 transition-colors duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 animate-on-scroll"
            style="transition-delay: 200ms"
          >
            İletişime Geç
          </a>
          <a
            href="/hizmetler"
            class="inline-flex items-center justify-center bg-white text-gray-800 border border-gray-300 px-8 py-3 rounded-lg font-semibold hover:border-accent-300 hover:text-accent-700 transition-colors duration-200 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 animate-on-scroll"
            style="transition-delay: 260ms"
          >
            Hizmetleri İncele
          </a>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  import { observeScrollAnimations } from '../presentation/utils/animations';

  function initAnimations() {
    observeScrollAnimations('.animate-on-scroll');
    observeScrollAnimations('.cta-section');
  }

  document.addEventListener('DOMContentLoaded', initAnimations);
  initAnimations();
</script>

<style>
  .cta-section {
    opacity: 0;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-section.animate-in {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-section {
      opacity: 1 !important;
      transition: none !important;
    }
  }
</style>
