---

<BaseLayout
  title="Referanslar - Process"
  description="Process'in tamamladığı projeleri ve müşteri referanslarını inceleyin. 500+ başarılı proje ile yapı sektöründe güvenilir çözüm ortağınız."
>
  <Section bgColor="gray">
    <div class="py-16 md:py-20 px-4 sm:px-6 lg:px-10">
      <div class="max-w-4xl mx-auto text-center mb-12 md:mb-16 animate-on-scroll">
        <p class="inline-flex items-center rounded-full bg-accent-100 text-accent-700 px-4 py-1 text-sm font-semibold tracking-wide mb-5">
          Tamamlanan İşler
        </p>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight">
          Referans Projelerimiz
        </h1>
        <p class="text-lg md:text-xl text-gray-600 leading-8">
          20+ yıllık tecrübemizle 500'ü aşkın projeyi başarıyla tamamladık
        </p>
      </div>

      <div class="mb-8 filter-container animate-on-scroll" style="transition-delay: 100ms">
        <div class="flex flex-wrap gap-3 justify-center" role="group" aria-label="Referans kategorisi filtreleri">
          <button
            class="filter-btn active px-4 py-2 rounded-xl border border-accent-500 bg-accent-500 text-white font-medium transition-all duration-200 hover:bg-accent-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent-500 cursor-pointer"
            data-filter="all"
            aria-pressed="true"
          >
            Tümü
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl border border-gray-200 bg-white text-gray-700 font-medium hover:border-accent-300 hover:bg-accent-50 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent-500 cursor-pointer"
            data-filter="guclendirme"
            aria-pressed="false"
          >
            Güçlendirme
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl border border-gray-200 bg-white text-gray-700 font-medium hover:border-accent-300 hover:bg-accent-50 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent-500 cursor-pointer"
            data-filter="su-yalitim"
            aria-pressed="false"
          >
            Su Yalıtım
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl border border-gray-200 bg-white text-gray-700 font-medium hover:border-accent-300 hover:bg-accent-50 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent-500 cursor-pointer"
            data-filter="zemin-kaplama"
            aria-pressed="false"
          >
            Zemin Kaplama
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl border border-gray-200 bg-white text-gray-700 font-medium hover:border-accent-300 hover:bg-accent-50 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent-500 cursor-pointer"
            data-filter="cati-sistemleri"
            aria-pressed="false"
          >
            Çatı Sistemleri
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl border border-gray-200 bg-white text-gray-700 font-medium hover:border-accent-300 hover:bg-accent-50 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent-500 cursor-pointer"
            data-filter="ic-mekan-uygulamalari"
            aria-pressed="false"
          >
            İç Mekan
          </button>
          <button
            class="filter-btn px-4 py-2 rounded-xl border border-gray-200 bg-white text-gray-700 font-medium hover:border-accent-300 hover:bg-accent-50 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent-500 cursor-pointer"
            data-filter="anahtar-teslim"
            aria-pressed="false"
          >
            Anahtar Teslim
          </button>
        </div>
      </div>

      <p id="filter-result-info" class="text-center text-sm md:text-base text-gray-600 mb-10 animate-on-scroll" style="transition-delay: 150ms">
        {references.length} referans projesi listeleniyor.
      </p>

      <div id="references-grid" class="references-grid">
        <References references={references} />
      </div>

      <div id="empty-state" class="hidden text-center bg-white border border-dashed border-gray-300 rounded-2xl py-12 px-6 mt-8">
        <p class="text-lg font-semibold text-gray-800 mb-2">Bu kategoride henüz proje bulunmuyor.</p>
        <p class="text-gray-600">Lütfen başka bir filtre seçerek tüm projeleri inceleyin.</p>
      </div>
    </div>
  </Section>

  <Section bgColor="white">
    <div class="py-20">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-gray-900 text-center mb-12 animate-on-scroll">
          Başarı Rakamlarımız
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
          <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center animate-scale" style="transition-delay: 0ms">
            <div class="w-16 h-16 bg-accent-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-accent-600">500+</span>
            </div>
            <p class="font-semibold text-gray-900 text-sm md:text-base">Tamamlanan Proje</p>
          </div>
          <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center animate-scale" style="transition-delay: 100ms">
            <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-primary-600">20+</span>
            </div>
            <p class="font-semibold text-gray-900 text-sm md:text-base">Yıllık Tecrübe</p>
          </div>
          <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center animate-scale" style="transition-delay: 200ms">
            <div class="w-16 h-16 bg-secondary-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-secondary-600">100%</span>
            </div>
            <p class="font-semibold text-gray-900 text-sm md:text-base">Müşteri Memnuniyeti</p>
          </div>
          <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center animate-scale" style="transition-delay: 300ms">
            <div class="w-16 h-16 bg-dark-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-dark-600">50+</span>
            </div>
            <p class="font-semibold text-gray-900 text-sm md:text-base">Uzman Personel</p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section bgColor="gray-600" animate={true} animationType="scale">
    <div class="py-16 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        Sizin de Projeniz Hazır Mı?
      </h2>
      <p class="text-lg text-neutral-100 mb-6 max-w-2xl mx-auto">
        Başarılı projelerimize bir yenisini eklemek için sabırsızlanıyoruz
      </p>
      <a
        href="/iletisim"
        class="inline-block bg-white text-primary-700 px-8 py-3 rounded-lg font-medium hover:bg-gray-100 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-white"
      >
        Teklif Alın
      </a>
    </div>
  </Section>
</BaseLayout>

<script>
  import { observeScrollAnimations } from '../presentation/utils/animations';

  function initAnimations(): void {
    observeScrollAnimations('.animate-on-scroll');
    observeScrollAnimations('.animate-fade');
    observeScrollAnimations('.animate-scale');
  }

  function initReferenceFilter(): void {
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-reference-card]'));
    const resultInfo = document.getElementById('filter-result-info');
    const emptyState = document.getElementById('empty-state');

    if (filterButtons.length === 0 || cards.length === 0 || !resultInfo || !emptyState) {
      return;
    }

    const updateActiveButton = (selectedButton: HTMLButtonElement): void => {
      filterButtons.forEach((button) => {
        const isActive = button === selectedButton;
        button.setAttribute('aria-pressed', String(isActive));
        button.classList.toggle('bg-accent-500', isActive);
        button.classList.toggle('text-white', isActive);
        button.classList.toggle('border-accent-500', isActive);
        button.classList.toggle('bg-white', !isActive);
        button.classList.toggle('text-gray-700', !isActive);
        button.classList.toggle('border-gray-200', !isActive);
      });
    };

    const applyFilter = (selectedFilter: string): void => {
      let visibleCount = 0;

      cards.forEach((card) => {
        const category = card.dataset.category ?? '';
        const shouldShow = selectedFilter === 'all' || selectedFilter === category;
        card.classList.toggle('hidden', !shouldShow);
        if (shouldShow) {
          visibleCount += 1;
        }
      });

      resultInfo.textContent = `${visibleCount} referans projesi listeleniyor.`;
      emptyState.classList.toggle('hidden', visibleCount > 0);
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const selectedFilter = button.dataset.filter ?? 'all';
        updateActiveButton(button);
        applyFilter(selectedFilter);
      });
    });
  }

  function initPage(): void {
    initAnimations();
    initReferenceFilter();
  }

  document.addEventListener('DOMContentLoaded', initPage);
  document.addEventListener('astro:page-load', initPage);
</script>
