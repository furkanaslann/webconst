---
import BaseLayout from '../presentation/layouts/BaseLayout.astro';
import Section from '../presentation/components/ui/Section.astro';
import References from '../presentation/components/References.astro';
import type { Reference } from '../presentation/components/References.astro';
import { referenceImageUrls } from '../core/constants/referenceImages';

const references: Reference[] = [
  {
    id: '10',
    title: 'Konut Çatı Yenileme',
    location: 'Kayseri',
    year: '2024',
    description: 'Toplu konut bloklarında çatı kaplama, ısı yalıtımı ve yağmur suyu drenaj hattı yenilemesi.',
    image: referenceImageUrls.cati,
  },
  {
    id: '12',
    title: 'Niğde Ferbis',
    location: 'Niğde',
    year: '2023',
    description: 'Mekanik altyapı, ince işler, zemin kaplama ve iç mimari uygulamaların tek elden yönetildiği dönüşüm.',
    image: referenceImageUrls.nigdeBorFerbis,
  },
  {
    id: '13',
    title: 'Avantgarde Refined Caves of Cappadocia',
    location: 'Kapadokya',
    year: '2025',
    description: 'Doğal dokuya uyumlu taş yüzey uygulamaları, havuz çevresi peyzaj detayları ve ince yapı işlerinin tek elden yürütüldüğü kapsamlı bir projedir.',
    image: referenceImageUrls.avantgardeCavesCappadocia,
  },
];
---

<BaseLayout
  title="Referanslar - Process"
  description="Process'in tamamladığı projeleri ve müşteri referanslarını inceleyin. 500+ başarılı proje ile yapı sektöründe güvenilir çözüm ortağınız."
>
  <Section bgColor="gray">
    <div class="py-16 md:py-20 px-4 sm:px-6 lg:px-10">
      <div class="max-w-4xl mx-auto text-center mb-12 md:mb-16 animate-on-scroll">
        <p class="inline-flex items-center rounded-full bg-accent-100 text-accent-700 px-4 py-1 text-sm font-semibold tracking-wide mb-5">
          Tamamlanan İşler
        </p>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight">
          Referans Projelerimiz
        </h1>
        <p class="text-lg md:text-xl text-gray-600 leading-8">
          20+ yıllık tecrübemizle 500'ü aşkın projeyi başarıyla tamamladık
        </p>
      </div>

      <p class="text-center text-sm md:text-base text-gray-600 mb-10 animate-on-scroll" style="transition-delay: 150ms">
        {references.length} referans projesi listeleniyor.
      </p>

      <div class="references-grid">
        <References references={references} />
      </div>
    </div>
  </Section>

  <Section bgColor="white">
    <div class="py-20">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-gray-900 text-center mb-12 animate-on-scroll">
          Başarı Rakamlarımız
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
          <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center animate-scale" style="transition-delay: 0ms">
            <div class="w-16 h-16 bg-accent-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-accent-600">500+</span>
            </div>
            <p class="font-semibold text-gray-900 text-sm md:text-base">Tamamlanan Proje</p>
          </div>
          <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center animate-scale" style="transition-delay: 100ms">
            <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-primary-600">20+</span>
            </div>
            <p class="font-semibold text-gray-900 text-sm md:text-base">Yıllık Tecrübe</p>
          </div>
          <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center animate-scale" style="transition-delay: 200ms">
            <div class="w-16 h-16 bg-secondary-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-secondary-600">100%</span>
            </div>
            <p class="font-semibold text-gray-900 text-sm md:text-base">Müşteri Memnuniyeti</p>
          </div>
          <div class="rounded-2xl border border-gray-200 bg-white p-6 text-center animate-scale" style="transition-delay: 300ms">
            <div class="w-16 h-16 bg-dark-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-2xl font-bold text-dark-600">50+</span>
            </div>
            <p class="font-semibold text-gray-900 text-sm md:text-base">Uzman Personel</p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section bgColor="gray-600" animate={true} animationType="scale">
    <div class="py-16 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        Sizin de Projeniz Hazır Mı?
      </h2>
      <p class="text-lg text-neutral-100 mb-6 max-w-2xl mx-auto">
        Başarılı projelerimize bir yenisini eklemek için sabırsızlanıyoruz
      </p>
      <a
        href="/iletisim"
        class="inline-block bg-white text-primary-700 px-8 py-3 rounded-lg font-medium hover:bg-gray-100 transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-white"
      >
        Teklif Alın
      </a>
    </div>
  </Section>
</BaseLayout>

<script>
  import { observeScrollAnimations } from '../presentation/utils/animations';

  function initAnimations(): void {
    observeScrollAnimations('.animate-on-scroll');
    observeScrollAnimations('.animate-fade');
    observeScrollAnimations('.animate-scale');
  }

  function initPage(): void {
    initAnimations();
  }

  document.addEventListener('DOMContentLoaded', initPage);
  document.addEventListener('astro:page-load', initPage);
</script>
