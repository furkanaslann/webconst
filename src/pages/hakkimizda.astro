---
import BaseLayout from '../presentation/layouts/BaseLayout.astro';
import Section from '../presentation/components/ui/Section.astro';
---

<BaseLayout
  title="Hakkımızda | Process"
  description="Process olarak Kayseri merkezli ekibimizle yapısal-teknik ve mimari-dekoratif yapı çözümleri sunuyoruz: güçlendirme, yalıtım, tadilat ve anahtar teslim süreçlerinde 20+ yıl tecrübe ve 500+ tamamlanmış proje."
>
  <Section bgColor="gray">
    <div class="py-16 md:py-20 px-4 md:px-6">
      <div class="mx-auto max-w-6xl text-center mb-12 md:mb-16 animate-on-scroll">
        <p
          class="inline-flex items-center rounded-full bg-white px-4 py-2 text-sm font-semibold text-accent-700 ring-1 ring-accent-100"
        >
          Kurumsal kimlik ve saha tecrübesi
        </p>
        <h1 class="mt-6 text-4xl md:text-5xl font-bold text-gray-900 tracking-tight">
          Hakkımızda
        </h1>
        <p
          class="mt-6 text-lg md:text-xl text-gray-700 leading-relaxed max-w-3xl mx-auto"
        >
          Yapısal güvenlikten yaşam alanı konforuna uzanan çözümleri tek çatı altında
          yönetiyor; her projede teknik disiplin, şeffaf iletişim ve sürdürülebilir kaliteyi
          öne çıkarıyoruz.
        </p>
      </div>

      <div class="mx-auto max-w-6xl grid md:grid-cols-2 gap-12 lg:gap-16 items-center mb-20 md:mb-24">
        <div class="animate-slide-left space-y-5 text-left">
          <h2 id="biz-kimiz-baslik" class="text-3xl font-bold text-gray-900">
            Biz Kimiz?
          </h2>
          <p class="text-gray-700 leading-relaxed">
            Process, 2000&apos;li yılların başından bu yana yapı sektöründe faaliyet gösteren,
            <strong class="font-semibold text-gray-900">yapısal-teknik</strong> ve
            <strong class="font-semibold text-gray-900">mimari-dekoratif</strong>
            işleri aynı ekip düzeninde yürüten Kayseri merkezli bir kuruluştur. Güçlendirme,
            su yalıtımı, zemin kaplama ve yapı kimyasalları gibi taşıyıcı ve dayanıklılık
            odaklı hizmetlerin yanında; tadilat, boya, cephe ve iç mekân çözümleriyle
            projelerinizi uçtan uca tamamlıyoruz.
          </p>
          <p class="text-gray-700 leading-relaxed">
            Deprem yönetmeliğine uygun güçlendirme uygulamalarıyla başlayan yolculuğumuz,
            zamanla genişleyen bir hizmet yelpazesine dönüştü. Bugün Kayseri ve çevre
            illerde <strong class="font-semibold text-gray-900">500&apos;ü aşkın projeyi</strong>
            başarıyla teslim ettik.
          </p>
          <p class="text-gray-700 leading-relaxed">
            Uzman mühendis ve mimar kadromuz ile sertifikalı uygulama ekibimiz, sahada aynı
            kalite standardını korur; taahhütlerimizi net zaman çizelgeleri ve ölçülebilir
            kontrol adımlarıyla yönetiriz.
          </p>
        </div>

        <div
          class="relative aspect-square rounded-2xl overflow-hidden flex items-center justify-center animate-slide-right border border-white/60 shadow-sm"
        >
          <img
            src="https://picsum.photos/seed/about-process-bright-site/1200/1200"
            alt="İnşaat sahasında proje koordinasyon çalışması"
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-br from-white/10 via-white/20 to-white/30" aria-hidden="true"></div>
          <div class="relative text-center p-8 md:p-10 bg-white/80 rounded-2xl">
            <p class="text-primary-800 font-semibold text-lg md:text-xl">20+ yıllık tecrübe</p>
            <p class="text-gray-700 mt-2 text-base">500+ tamamlanan proje</p>
          </div>
        </div>
      </div>

      <div class="mx-auto max-w-6xl mb-20 md:mb-24 values-section">
        <section aria-labelledby="degerler-baslik">
          <h2
            id="degerler-baslik"
            class="text-3xl font-bold text-gray-900 text-center mb-12 animate-on-scroll"
          >
            Değerlerimiz
          </h2>

          <div class="grid md:grid-cols-3 gap-6 md:gap-8">
            <div
              class="bg-white p-8 rounded-xl border border-gray-100 shadow-md text-center value-card transition-shadow duration-200 hover:shadow-lg"
              style="transition-delay: 0ms"
            >
              <div
                class="w-16 h-16 bg-accent-100 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <svg
                  class="w-8 h-8 text-accent-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Kalite</h3>
              <p class="text-gray-700 leading-relaxed">
                Her projede en yüksek kalite standartlarını uyguluyoruz. Kullandığımız
                malzemelerde TSE ve CE uyumluluğunu ön planda tutuyoruz.
              </p>
            </div>

            <div
              class="bg-white p-8 rounded-xl border border-gray-100 shadow-md text-center value-card transition-shadow duration-200 hover:shadow-lg"
              style="transition-delay: 150ms"
            >
              <div
                class="w-16 h-16 bg-accent-100 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <svg
                  class="w-8 h-8 text-accent-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 mb-3">Güven</h3>
              <p class="text-gray-700 leading-relaxed">
                Müşterilerimizle şeffaf ve dürüst ilişkiler kuruyoruz. Taahhüt ettiğimiz
                çerçevede planlama yapıyor ve iletişimi süreç boyunca açık tutuyoruz.
              </p>
            </div>

            <div
              class="bg-white p-8 rounded-xl border border-gray-100 shadow-md text-center value-card transition-shadow duration-200 hover:shadow-lg"
              style="transition-delay: 300ms"
            >
              <div
                class="w-16 h-16 bg-accent-100 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <svg
                  class="w-8 h-8 text-accent-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 mb-3">İnovasyon</h3>
              <p class="text-gray-700 leading-relaxed">
                Eğitimli kadromuzla sektördeki yeni teknikleri ve malzemeleri izliyor;
                projeye özel, ölçülebilir çözümler üretiyoruz.
              </p>
            </div>
          </div>
        </section>
      </div>

      <div class="mx-auto max-w-6xl mb-20 md:mb-24">
        <section aria-labelledby="neden-biz-baslik">
          <h2
            id="neden-biz-baslik"
            class="text-3xl font-bold text-gray-900 text-center mb-10 md:mb-12 animate-on-scroll"
          >
            Neden Process?
          </h2>
          <div class="grid md:grid-cols-2 gap-6 md:gap-8 features-grid">
            <div
              class="bg-primary-50 rounded-2xl border border-primary-100/80 p-8 feature-card transition-shadow duration-200 hover:shadow-md"
              style="transition-delay: 0ms"
            >
              <div class="flex items-center mb-4">
                <div
                  class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mr-4 shrink-0"
                >
                  <svg
                    class="w-6 h-6 text-primary-600"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    ></path>
                  </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900">Güvenilirlik</h3>
              </div>
              <p class="text-gray-700 leading-relaxed">
                İş güvenliği önlemlerini ve saha kurallarını eksiksiz uyguluyor; ekip ve
                paydaş güvenliğini her aşamada önceliklendiriyoruz.
              </p>
            </div>

            <div
              class="bg-secondary-50 rounded-2xl border border-secondary-100/80 p-8 feature-card transition-shadow duration-200 hover:shadow-md"
              style="transition-delay: 150ms"
            >
              <div class="flex items-center mb-4">
                <div
                  class="w-12 h-12 bg-secondary-100 rounded-lg flex items-center justify-center mr-4 shrink-0"
                >
                  <svg
                    class="w-6 h-6 text-secondary-600"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                  </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900">Ekonomik çözümler</h3>
              </div>
              <p class="text-gray-700 leading-relaxed">
                Kaliteyi koruyarak maliyet etkin alternatifler sunuyor; bütçeye uygun
                senaryoları teknik olarak değerlendirip netleştiriyoruz.
              </p>
            </div>
          </div>
        </section>
      </div>

      <div class="mx-auto max-w-6xl">
        <section
          class="bg-white rounded-2xl shadow-md border border-gray-100 p-8 md:p-12"
          aria-labelledby="bolgeler-baslik"
        >
          <h2
            id="bolgeler-baslik"
            class="text-3xl font-bold text-gray-900 text-center mb-8 md:mb-10 animate-on-scroll"
          >
            Hizmet bölgelerimiz
          </h2>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
            <div class="text-center location-card p-4 rounded-xl bg-gray-50/80" style="transition-delay: 0ms">
              <div
                class="w-14 h-14 md:w-16 md:h-16 bg-accent-100 rounded-lg flex items-center justify-center mx-auto mb-3"
              >
                <svg
                  class="w-7 h-7 md:w-8 md:h-8 text-accent-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  ></path>
                </svg>
              </div>
              <p class="font-semibold text-gray-900">Kayseri</p>
              <p class="text-sm text-gray-600 mt-1">Merkez</p>
            </div>

            <div class="text-center location-card p-4 rounded-xl bg-gray-50/80" style="transition-delay: 100ms">
              <div
                class="w-14 h-14 md:w-16 md:h-16 bg-primary-100 rounded-lg flex items-center justify-center mx-auto mb-3"
              >
                <svg
                  class="w-7 h-7 md:w-8 md:h-8 text-primary-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  ></path>
                </svg>
              </div>
              <p class="font-semibold text-gray-900">Nevşehir</p>
              <p class="text-sm text-gray-600 mt-1">Hizmet bölgesi</p>
            </div>

            <div class="text-center location-card p-4 rounded-xl bg-gray-50/80" style="transition-delay: 200ms">
              <div
                class="w-14 h-14 md:w-16 md:h-16 bg-secondary-100 rounded-lg flex items-center justify-center mx-auto mb-3"
              >
                <svg
                  class="w-7 h-7 md:w-8 md:h-8 text-secondary-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  ></path>
                </svg>
              </div>
              <p class="font-semibold text-gray-900">Yozgat</p>
              <p class="text-sm text-gray-600 mt-1">Hizmet bölgesi</p>
            </div>

            <div class="text-center location-card p-4 rounded-xl bg-gray-50/80" style="transition-delay: 300ms">
              <div
                class="w-14 h-14 md:w-16 md:h-16 bg-dark-100 rounded-lg flex items-center justify-center mx-auto mb-3"
              >
                <svg
                  class="w-7 h-7 md:w-8 md:h-8 text-dark-600"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  ></path>
                </svg>
              </div>
              <p class="font-semibold text-gray-900">Sivas</p>
              <p class="text-sm text-gray-600 mt-1">Hizmet bölgesi</p>
            </div>
          </div>

          <nav
            class="mt-10 flex flex-col sm:flex-row flex-wrap items-center justify-center gap-3 sm:gap-4"
            aria-label="İlgili sayfalar"
          >
            <a
              href="/hizmetler"
              class="inline-flex items-center justify-center rounded-lg border border-gray-200 bg-gray-50 px-5 py-2.5 text-sm font-semibold text-gray-800 transition-colors duration-200 hover:bg-white hover:border-accent-200 hover:text-accent-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 cursor-pointer min-h-[44px]"
            >
              Hizmetleri incele
            </a>
            <a
              href="/referanslar"
              class="inline-flex items-center justify-center rounded-lg border border-gray-200 bg-gray-50 px-5 py-2.5 text-sm font-semibold text-gray-800 transition-colors duration-200 hover:bg-white hover:border-primary-200 hover:text-primary-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 cursor-pointer min-h-[44px]"
            >
              Referansları görüntüle
            </a>
          </nav>
        </section>
      </div>
    </div>
  </Section>

  <Section bgColor="gray-600">
    <div class="py-16 md:py-20 px-4 text-center cta-content animate-scale">
      <div class="mx-auto max-w-2xl">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
          Birlikte çalışalım
        </h2>
        <p class="text-lg text-neutral-100 mb-8 leading-relaxed">
          Projeniz için keşif, teknik değerlendirme ve uygulama planı hakkında ekibimizle
          iletişime geçebilirsiniz.
        </p>
        <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center gap-4">
          <a
            href="/iletisim"
            class="inline-flex items-center justify-center min-h-[44px] min-w-[160px] cursor-pointer rounded-lg bg-white px-8 py-3 font-semibold text-primary-700 shadow-sm transition-colors duration-200 hover:bg-neutral-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-gray-600"
          >
            İletişime geç
          </a>
          <a
            href="/hizmetler"
            class="inline-flex items-center justify-center min-h-[44px] min-w-[160px] cursor-pointer rounded-lg border-2 border-white/80 px-8 py-3 font-semibold text-white transition-colors duration-200 hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-gray-600"
          >
            Hizmetlere göz at
          </a>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .value-card {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.2s ease;
  }

  .value-card.animate-in {
    opacity: 1;
    transform: translateY(0);
  }

  .feature-card {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.2s ease;
  }

  .feature-card.animate-in {
    opacity: 1;
    transform: translateY(0);
  }

  .location-card {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .location-card.animate-in {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .value-card,
    .feature-card,
    .location-card,
    .cta-content {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  .cta-content {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-content.animate-in {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  import { observeScrollAnimations } from '../presentation/utils/animations';

  function initAnimations() {
    observeScrollAnimations('.animate-on-scroll');
    observeScrollAnimations('.animate-slide-left');
    observeScrollAnimations('.animate-slide-right');
    observeScrollAnimations('.cta-content');

    const valueCards = document.querySelectorAll('.value-card');
    const valueObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
            valueObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2, rootMargin: '0px 0px -50px 0px' }
    );
    valueCards.forEach((card) => valueObserver.observe(card));

    const featureCards = document.querySelectorAll('.feature-card');
    const featureObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
            featureObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2, rootMargin: '0px 0px -50px 0px' }
    );
    featureCards.forEach((card) => featureObserver.observe(card));

    const locationCards = document.querySelectorAll('.location-card');
    const locationObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
            locationObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2, rootMargin: '0px 0px -50px 0px' }
    );
    locationCards.forEach((card) => locationObserver.observe(card));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnimations);
  } else {
    initAnimations();
  }
</script>
