---
import BaseLayout from '../presentation/layouts/BaseLayout.astro';
import HeroSection from '../presentation/components/blocks/HeroSection.astro';
import ServiceCard from '../presentation/components/blocks/ServiceCard.astro';
import Section from '../presentation/components/ui/Section.astro';
import { services } from '../core/constants/services';

const trustHighlights = [
  {
    value: '20+',
    label: 'Yıllık Sektör Deneyimi',
    detail: 'Uzun soluklu saha ve uygulama birikimi',
    icon: 'clock',
  },
  {
    value: '500+',
    label: 'Tamamlanan Proje',
    detail: 'Konut, ticari ve endüstriyel referanslar',
    icon: 'project',
  },
  {
    value: '%100',
    label: 'Mevzuat Uyumlu Yaklaşım',
    detail: 'Deprem yönetmeliğine uygun çözüm planlama',
    icon: 'shield',
  },
  {
    value: 'Tek Nokta',
    label: 'Uçtan Uca Hizmet',
    detail: 'Keşif, projelendirme ve uygulama tek ekipte',
    icon: 'layers',
  },
];

const processSteps = [
  {
    title: 'Ücretsiz Keşif',
    description: 'Sahada mevcut durumu analiz ediyor, teknik ihtiyaçları net şekilde belirliyoruz.',
  },
  {
    title: 'Teknik Çözüm Planı',
    description: 'Yapıya özel, mevzuata uygun ve maliyet etkin bir uygulama planı hazırlıyoruz.',
  },
  {
    title: 'Uygulama ve Kontrol',
    description: 'Uzman ekibimizle uygulamayı gerçekleştiriyor, kalite kontrol adımlarını tamamlıyoruz.',
  },
  {
    title: 'Teslim ve Destek',
    description: 'Projeyi zamanında teslim ediyor, ihtiyaç duyduğunuzda teknik destek sağlıyoruz.',
  },
];

const sectors = [
  {
    title: 'Konut Projeleri',
    description: 'Bina güçlendirme ve yaşam alanı odaklı uygulamalar',
    href: '/hizmetler#tadilat-ve-yenileme',
    icon: 'home',
  },
  {
    title: 'Ticari Yapılar',
    description: 'Mağaza, ofis ve karma kullanım alanlarına uygun çözümler',
    href: '/hizmetler#zemin-kaplama',
    icon: 'office',
  },
  {
    title: 'Endüstriyel Tesisler',
    description: 'Yüksek dayanım gerektiren zemin ve yalıtım sistemleri',
    href: '/hizmetler#yapi-kimyasallari',
    icon: 'factory',
  },
  {
    title: 'Kamu Binaları',
    description: 'Uzun ömürlü, güvenli ve standartlara uygun uygulamalar',
    href: '/hizmetler#dis-cephe-mantolama-isi-yalitimi',
    icon: 'government',
  },
];

const getTrustIcon = (icon: string) => {
  const icons: Record<string, string> = {
    clock: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`,
    project: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>`,
    shield: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3l8 4v5c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V7l8-4z"></path></svg>`,
    layers: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3l9 4.5-9 4.5-9-4.5L12 3zm0 9l9 4.5-9 4.5-9-4.5L12 12z"></path></svg>`,
  };

  return icons[icon] || icons.clock;
};

const getSectorIcon = (icon: string) => {
  const icons: Record<string, string> = {
    home: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10.5L12 3l9 7.5M5 9v10h14V9"></path></svg>`,
    office: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 21h16M6 21V5a2 2 0 012-2h8a2 2 0 012 2v16M9 9h6m-6 4h6"></path></svg>`,
    factory: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M5 21V11l5 3V11l5 3V7l4 2v12"></path></svg>`,
    government: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M5 10v8m4-8v8m4-8v8m4-8v8M2 21h20M12 3l9 4H3l9-4z"></path></svg>`,
  };

  return icons[icon] || icons.home;
};
---

<BaseLayout
  title="Process | Yapısal, Teknik ve Dekoratif Yapı Çözümleri"
  description="Process ile yapısal-teknik ve mimari-dekoratif hizmetleri tek noktadan alın: güçlendirme, yalıtım, boya, tadilat, çatı yenileme ve anahtar teslim proje yönetimi."
>
  <HeroSection
    title="Yapınız İçin Güvenilir ve Ölçülebilir Çözümler"
    subtitle="Yapısal-teknik ve mimari-dekoratif hizmetlerimizi tek ekipte birleştiriyor; güçlendirme, yalıtım, tadilat ve anahtar teslim süreçleri güvenle yönetiyoruz."
    ctaText="Ücretsiz Keşif Talep Et"
    ctaLink="/iletisim"
    cta2Text="Hizmetleri İncele"
    cta2Link="/hizmetler"
    enableSlider={true}
  />

  <Section bgColor="gray">
    <div class="py-20 px-4">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-12">
        {trustHighlights.map((item) => (
          <div class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white px-5 py-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md">
            <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-accent-500 to-secondary-500" />
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-lg bg-accent-50 text-accent-700">
              <span set:html={getTrustIcon(item.icon)} />
            </div>
            <p class="text-2xl font-bold text-gray-900 leading-none mb-2">{item.value}</p>
            <p class="text-sm md:text-base font-semibold text-gray-800 mb-1">{item.label}</p>
            <p class="text-sm text-gray-600">{item.detail}</p>
          </div>
        ))}
      </div>

      <div class="text-center mb-12 animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Hizmetlerimiz
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Hizmetlerimizi iki ana grupta sunuyoruz: yapısal-teknik ve mimari-dekoratif çözümler
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <span class="inline-flex min-h-[40px] items-center rounded-full bg-accent-100 px-4 py-2 text-sm font-semibold text-accent-800">
            Yapısal & Teknik Çözümler
          </span>
          <span class="inline-flex min-h-[40px] items-center rounded-full bg-secondary-100 px-4 py-2 text-sm font-semibold text-secondary-800">
            Mimari & Dekoratif Çözümler
          </span>
        </div>
      </div>

      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8 services-grid">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </Section>

  <Section bgColor="white">
    <div class="py-20 px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="animate-slide-left">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            Neden Process?
          </h2>
          <div class="space-y-4">
            <div class="flex items-start animate-on-scroll" style="transition-delay: 0ms">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-accent-100 flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-accent-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </div>
              <p class="text-gray-700">20+ yıllık sektör tecrübesi</p>
            </div>
            <div class="flex items-start animate-on-scroll" style="transition-delay: 100ms">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-accent-100 flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-accent-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </div>
              <p class="text-gray-700">Uzman inşaat mühendisleri kadrosu</p>
            </div>
            <div class="flex items-start animate-on-scroll" style="transition-delay: 200ms">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-accent-100 flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-accent-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </div>
              <p class="text-gray-700">Deprem yönetmeliğine uygun projeler</p>
            </div>
            <div class="flex items-start animate-on-scroll" style="transition-delay: 300ms">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-accent-100 flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-accent-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </div>
              <p class="text-gray-700">Kaliteli malzeme ve işçilik garantisi</p>
            </div>
            <div class="flex items-start animate-on-scroll" style="transition-delay: 400ms">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-accent-100 flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-accent-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </div>
              <p class="text-gray-700">Zamanında proje teslimatı</p>
            </div>
          </div>
        </div>

        <div class="relative animate-slide-right">
          <div class="aspect-square bg-gradient-to-br from-secondary-100 via-neutral-100 to-accent-100 rounded-2xl flex items-center justify-center">
            <div class="text-center p-8">
              <div class="grid grid-cols-2 gap-6">
                <div class="bg-white/80 rounded-xl p-4 shadow-md animate-scale" style="transition-delay: 0ms">
                  <p class="text-3xl font-bold text-accent-600 stat-number" data-value="500">500+</p>
                  <p class="text-sm text-gray-700">Tamamlanan Proje</p>
                </div>
                <div class="bg-white/80 rounded-xl p-4 shadow-md animate-scale" style="transition-delay: 150ms">
                  <p class="text-3xl font-bold text-accent-600 stat-number" data-value="20">20+</p>
                  <p class="text-sm text-gray-700">Yıllık Tecrübe</p>
                </div>
                <div class="bg-white/80 rounded-xl p-4 shadow-md animate-scale" style="transition-delay: 300ms">
                  <p class="text-3xl font-bold text-accent-600 stat-number" data-value="100">%100</p>
                  <p class="text-sm text-gray-700">Müşteri Memnuniyeti</p>
                </div>
                <div class="bg-white/80 rounded-xl p-4 shadow-md animate-scale" style="transition-delay: 450ms">
                  <p class="text-3xl font-bold text-accent-600 stat-number" data-value="50">50+</p>
                  <p class="text-sm text-gray-700">Uzman Personel</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section bgColor="gray">
    <div class="py-20 px-4">
      <div class="text-center mb-12 animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Çalışma Sürecimiz
        </h2>
        <p class="text-xl text-gray-700 max-w-2xl mx-auto">
          İlk görüşmeden teslim aşamasına kadar şeffaf, kontrollü ve hızlı bir iş akışı sunuyoruz.
        </p>
      </div>

      <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((step, index) => (
          <li class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm animate-on-scroll">
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-accent-100 text-accent-700 font-semibold">
              {(index + 1).toString().padStart(2, '0')}
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-gray-700">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <Section bgColor="white">
    <div class="py-20 px-4">
      <div class="text-center mb-12 animate-on-scroll">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Hizmet Verdiğimiz Alanlar
        </h2>
        <p class="text-xl text-gray-700 max-w-2xl mx-auto">
          Farklı ölçek ve ihtiyaçtaki projeler için aynı kalite standardında çözümler üretiyoruz.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {sectors.map((sector) => (
          <a
            href={sector.href}
            class="group relative rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-accent-300 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-600 focus-visible:ring-offset-2 cursor-pointer"
          >
            <div class="absolute right-4 top-4 h-8 w-8 rounded-full bg-accent-50 text-accent-600 flex items-center justify-center transition-colors duration-300 group-hover:bg-accent-100">
              <span set:html={getSectorIcon(sector.icon)} />
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2 pr-10">{sector.title}</h3>
            <p class="text-sm text-gray-600 mb-4">{sector.description}</p>
            <span class="inline-flex items-center text-sm font-semibold text-accent-700">
              Detayları Gör
              <svg class="ml-2 h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </Section>

  <Section bgColor="gray-600" animate={true} animationType="scale">
    <div class="py-20 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
        Projeniz İçin Teklif Alın
      </h2>
      <p class="text-xl text-neutral-100 mb-8 max-w-2xl mx-auto">
        Yapısal güvenlikten dekoratif yenilemeye kadar tüm projeleriniz için ücretsiz keşif ve teklif alın
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/iletisim"
          class="inline-block bg-accent-500 text-white px-8 py-4 rounded-lg font-medium hover:bg-accent-600 transition-colors shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-accent-700 cursor-pointer"
        >
          Teklif Al
        </a>
        <a
          href="/referanslar"
          class="inline-block bg-white/10 text-white border-2 border-white/30 px-8 py-4 rounded-lg font-medium hover:bg-white/20 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-accent-700 cursor-pointer"
        >
          Referanslarımız
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  import { observeScrollAnimations, observeStaggeredAnimations, animateCounters } from '../presentation/utils/animations';

  function initAnimations() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    observeStaggeredAnimations('.services-grid .animate-on-scroll', 100);
    observeScrollAnimations('.animate-on-scroll');
    observeScrollAnimations('.animate-fade');
    observeScrollAnimations('.animate-slide-left');
    observeScrollAnimations('.animate-slide-right');
    observeScrollAnimations('.animate-scale');
    animateCounters('.stat-number');
  }

  document.addEventListener('DOMContentLoaded', initAnimations);
</script>
