---
import BaseLayout from '../presentation/layouts/BaseLayout.astro';
import ContactForm from '../presentation/components/blocks/ContactForm';
import Section from '../presentation/components/ui/Section.astro';

const contactInfo = {
  address: 'Mimarsinan OSB 1. Cad. No:4, Melikgazi / Kayseri',
  phone: '+90 532 000 00 00',
  email: 'info@process.com.tr',
  workingHours: 'Pazartesi - Cumartesi: 08:00 - 18:00',
};

const quickActions = [
  {
    title: 'Hemen Ara',
    description: 'Uzman ekibimizle telefonla doğrudan iletişime geçin.',
    href: `tel:${contactInfo.phone.replace(/\s/g, '')}`,
    cta: 'Telefonla ulaş',
  },
  {
    title: 'E-posta Gönder',
    description: 'Proje detaylarınızı yazarak en kısa sürede geri dönüş alın.',
    href: `mailto:${contactInfo.email}`,
    cta: 'E-posta gönder',
  },
];
---

<BaseLayout
  title="İletişim - Process"
  description="Process ile iletişime geçin. Kayseri merkezli inşaat hizmetlerimiz hakkında bilgi almak ve ücretsiz keşif için formu doldurun."
>
  <Section bgColor="gray">
    <div class="py-16 md:py-20 px-4 sm:px-6">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-10 md:mb-12 animate-on-scroll">
          <p class="inline-flex items-center rounded-full border border-primary-200 bg-primary-50 px-4 py-1 text-sm font-medium text-primary-700">
            Ücretsiz keşif ve hızlı geri dönüş
          </p>
          <h1 class="mt-4 text-4xl md:text-5xl font-bold text-gray-900">
            İletişime Geçin
          </h1>
          <p class="mt-4 text-lg md:text-xl text-gray-700 max-w-3xl mx-auto leading-relaxed">
            Projenizin ihtiyaçlarını birlikte netleştirelim. Formu doldurarak veya doğrudan arayarak
            aynı gün içinde uzman geri bildirimi alabilirsiniz.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 mb-10 md:mb-12 animate-on-scroll">
          {quickActions.map((action) => (
            <a
              href={action.href}
              class="group rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition-all duration-200 hover:border-primary-300 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2"
            >
              <h2 class="text-lg font-semibold text-gray-900">{action.title}</h2>
              <p class="mt-2 text-sm text-gray-600 leading-relaxed">{action.description}</p>
              <span class="mt-4 inline-flex items-center text-sm font-semibold text-primary-700 group-hover:text-primary-800">
                {action.cta}
              </span>
            </a>
          ))}
        </div>

        <div class="grid xl:grid-cols-[1.1fr_0.9fr] gap-8 md:gap-10">
          <div class="animate-slide-left rounded-2xl border border-gray-200 bg-white p-6 md:p-8 shadow-sm">
            <h2 class="text-2xl font-bold text-gray-900 mb-2">
              İletişim Formu
            </h2>
            <p class="text-sm text-gray-600 mb-6">
              Aşağıdaki alanları doldurun. Formunuz alındığında size e-posta veya telefon ile dönüş yaparız.
            </p>
            <ContactForm client:load />
          </div>

          <div class="animate-slide-right space-y-6">
            <div class="rounded-2xl border border-gray-200 bg-white p-6 md:p-7 shadow-sm">
              <h2 class="text-2xl font-bold text-gray-900 mb-6">
                İletişim Bilgileri
              </h2>

              <div class="space-y-6">
                <div class="flex items-start contact-info-item" style="transition-delay: 0ms">
                  <div class="flex-shrink-0 w-12 h-12 bg-accent-100 rounded-lg flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900 mb-1">Adres</h3>
                    <p class="text-gray-700 leading-relaxed">
                      {contactInfo.address}
                    </p>
                  </div>
                </div>

                <div class="flex items-start contact-info-item" style="transition-delay: 100ms">
                  <div class="flex-shrink-0 w-12 h-12 bg-accent-100 rounded-lg flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900 mb-1">E-posta</h3>
                    <a
                      href={`mailto:${contactInfo.email}`}
                      class="text-accent-700 hover:text-accent-800 underline-offset-2 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 rounded-sm"
                    >
                      {contactInfo.email}
                    </a>
                  </div>
                </div>

                <div class="flex items-start contact-info-item" style="transition-delay: 200ms">
                  <div class="flex-shrink-0 w-12 h-12 bg-accent-100 rounded-lg flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900 mb-1">Telefon</h3>
                    <a
                      href={`tel:${contactInfo.phone.replace(/\s/g, '')}`}
                      class="text-accent-700 hover:text-accent-800 underline-offset-2 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 rounded-sm"
                    >
                      {contactInfo.phone}
                    </a>
                  </div>
                </div>

                <div class="flex items-start contact-info-item" style="transition-delay: 300ms">
                  <div class="flex-shrink-0 w-12 h-12 bg-accent-100 rounded-lg flex items-center justify-center mr-4">
                    <svg class="w-6 h-6 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900 mb-1">Çalışma Saatleri</h3>
                    <p class="text-gray-700">
                      {contactInfo.workingHours}
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <div class="rounded-2xl border border-primary-100 bg-primary-50 p-6 info-box">
              <h3 class="font-semibold text-gray-900 mb-3">
                Neden Process?
              </h3>
              <ul class="space-y-2 text-sm text-gray-700 leading-relaxed">
                <li>- Yerinde keşif ve ihtiyaca özel çözüm planı</li>
                <li>- Uygulama öncesi net teknik bilgilendirme</li>
                <li>- Proje boyunca tek noktadan iletişim</li>
              </ul>
              <a
                href="https://maps.google.com/?q=Mimarsinan+OSB+1.+Cad.+No:4,+Melikgazi,+Kayseri"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex text-sm font-semibold text-primary-700 hover:text-primary-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 rounded-sm"
              >
                Haritada görüntüle
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section bgColor="gray-600">
    <div class="py-14 md:py-16 cta-section px-4 sm:px-6">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
          Projenizi birlikte planlayalım
        </h2>
        <p class="text-lg text-neutral-100 mb-8 leading-relaxed">
          Teknik ekibimiz ihtiyacınızı dinler, en uygun uygulama adımlarını net bir şekilde sunar.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a
            href={`tel:${contactInfo.phone.replace(/\s/g, '')}`}
            class="inline-flex items-center justify-center rounded-lg bg-white text-primary-700 px-8 py-3 font-semibold hover:bg-gray-100 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-gray-700"
          >
            Hemen Ara
          </a>
          <a
            href={`mailto:${contactInfo.email}`}
            class="inline-flex items-center justify-center rounded-lg border border-white/70 text-white px-8 py-3 font-semibold hover:bg-white/10 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-gray-700"
          >
            E-posta Gönder
          </a>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .contact-info-item {
    opacity: 0;
    transform: translateX(20px);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-info-item.animate-in {
    opacity: 1;
    transform: translateX(0);
  }

  .info-box {
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .info-box.animate-in {
    opacity: 1;
    transform: translateY(0);
  }

  .cta-section {
    opacity: 0;
    transform: scale(0.95);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta-section.animate-in {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-info-item,
    .info-box,
    .cta-section {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  import { observeScrollAnimations } from '../presentation/utils/animations';

  function initAnimations() {
    observeScrollAnimations('.animate-on-scroll');
    observeScrollAnimations('.animate-slide-left');
    observeScrollAnimations('.animate-slide-right');
    // Contact info items
    const contactItems = document.querySelectorAll('.contact-info-item');
    const contactObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-in');
          contactObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2, rootMargin: '0px 0px -50px 0px' });
    contactItems.forEach(item => contactObserver.observe(item));

    // Info box
    const infoBox = document.querySelector('.info-box');
    if (infoBox) {
      const infoBoxObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
            infoBoxObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2, rootMargin: '0px 0px -50px 0px' });
      infoBoxObserver.observe(infoBox);
    }

    // CTA section
    const ctaSection = document.querySelector('.cta-section');
    if (ctaSection) {
      const ctaObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
            ctaObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      ctaObserver.observe(ctaSection);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnimations, { once: true });
  } else {
    initAnimations();
  }
</script>
