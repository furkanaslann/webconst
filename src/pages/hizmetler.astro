---
import BaseLayout from '../presentation/layouts/BaseLayout.astro';
import Section from '../presentation/components/ui/Section.astro';
import { services } from '../core/constants/services';
import { Image } from 'astro:assets';

const groupedServices = [
  {
    id: 'yapisal-teknik',
    title: 'Yapısal & Teknik Çözümler',
    description: 'Taşıyıcı sistem, yalıtım ve dayanıklılık odaklı teknik uygulamalar.',
    services: services.filter((service) => service.category === 'yapisal-teknik'),
  },
  {
    id: 'mimari-dekoratif',
    title: 'Mimari & Dekoratif Çözümler',
    description: 'Mekanın estetik, işlevsel ve kullanım konforunu artıran çözümler.',
    services: services.filter((service) => service.category === 'mimari-dekoratif'),
  },
];

const processSteps = [
  {
    title: 'Keşif ve analiz',
    description: 'Yapının mevcut durumunu sahada inceliyor, risk ve ihtiyaçları teknik olarak raporluyoruz.',
  },
  {
    title: 'Teklif ve planlama',
    description: 'Bütçe, malzeme ve uygulama takvimini şeffaf bir planla netleştiriyoruz.',
  },
  {
    title: 'Uygulama ve teslim',
    description: 'Standartlara uygun uygulama sonrası kalite kontrolleriyle projeyi güvenle teslim ediyoruz.',
  },
];
---

<BaseLayout
  title="Hizmetler - Process"
  description="Process'in yapısal-teknik ve mimari-dekoratif hizmetlerini keşfedin: güçlendirme, yalıtım, boya, tadilat, çatı ve anahtar teslim çözümler."
>
  <Section bgColor="gray">
    <div class="py-16 md:py-20 px-4 md:px-6">
      <div class="mx-auto max-w-6xl">
        <div class="text-center mb-12 md:mb-16 animate-on-scroll">
          <p class="inline-flex items-center rounded-full bg-white px-4 py-2 text-sm font-semibold text-accent-700 ring-1 ring-accent-100">
            Yapısal güvenlik ve dayanıklı çözümler
          </p>
          <h1 class="mt-6 text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Hizmetlerimiz
          </h1>
          <p class="text-lg md:text-xl leading-relaxed text-gray-700 max-w-3xl mx-auto">
            Yapı sektöründe 20+ yıllık tecrübemizle güvenilir hizmetler sunuyoruz.
            Her projede teknik kaliteyi, sahadaki hızlı uygulamayı ve iletişimde
            şeffaflığı birlikte yönetiyoruz.
          </p>
        </div>

        <div class="grid gap-8 lg:grid-cols-[320px,1fr] lg:items-start">
          <aside class="quick-nav-wrap animate-fade lg:sticky lg:top-28">
            <div class="rounded-2xl border border-accent-100 bg-gradient-to-b from-white to-accent-50/40 p-4 md:p-5 shadow-sm">
              <div class="mb-4 inline-flex rounded-xl border border-accent-100 bg-white/90 px-4 py-3" style="border-color: rgb(252 165 165);">
                <p class="text-xs font-semibold uppercase tracking-wide text-accent-700">Hızlı Erişim</p>
               </div>
              <div class="space-y-3">
                {groupedServices.map((group, groupIndex) => (
                  <details class="quick-nav-accordion rounded-xl border border-gray-200 bg-gray-50" open={groupIndex === 0} data-group-id={group.id}>
                    <summary class="quick-nav-summary">
                      <span class="text-sm font-semibold text-gray-900">{group.title}</span>
                      <svg class="quick-nav-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </summary>
                    <div class="quick-nav-panel">
                      <nav aria-label={`${group.title} hizmetleri`} class="quick-nav-panel-content px-3 pb-3 space-y-2">
                        {group.services.map((service) => (
                          <a
                            href={`#${service.slug}`}
                            class="quick-nav-link"
                            data-service-link
                            data-target={service.slug}
                            data-group-id={group.id}
                          >
                            {service.title}
                          </a>
                        ))}
                      </nav>
                    </div>
                  </details>
                ))}
              </div>
            </div>
          </aside>

          <div class="space-y-14 md:space-y-16 services-list">
            {groupedServices.map((group) => (
              <section id={group.id} class="group-block animate-fade">
                <div class="mb-8 rounded-2xl border border-accent-100 bg-accent-50/60 p-5 md:p-6">
                  <h2 class="text-2xl md:text-3xl font-bold text-gray-900">{group.title}</h2>
                  <p class="mt-2 text-gray-700">{group.description}</p>
                </div>

                <div class="space-y-16 md:space-y-20">
                  {group.services.map((service, index) => (
                    <article
                      id={service.slug}
                      class={`scroll-mt-32 group/service service-item relative overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-5 md:p-8 lg:p-9 shadow-[0_12px_40px_rgba(15,23,42,0.07)] ring-1 ring-slate-100/80 ${
                        index === 0 ? 'is-initial-visible' : ''
                      }`}
                      style={`transition-delay: ${index * 120}ms`}
                      data-service-section
                      data-group-id={group.id}
                    >
                      <div class="service-item-accent" aria-hidden="true"></div>
                      <div class="space-y-8">
                        <div class="relative grid md:grid-cols-2 gap-7 md:gap-10 md:items-center">
                          <div class={index % 2 === 1 ? 'md:order-2' : ''}>
                            <div class="service-image-wrap service-image rounded-2xl bg-gradient-to-br from-slate-100 to-slate-50 p-[2px] shadow-[0_8px_30px_rgba(15,23,42,0.12)]">
                              <div class="aspect-[4/3] overflow-hidden rounded-[0.875rem] bg-neutral-100">
                                <button
                                  type="button"
                                  class="h-full w-full cursor-zoom-in focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/90 focus-visible:ring-offset-2 focus-visible:ring-offset-black/20"
                                  data-lightbox-item
                                  data-lightbox-group={`service-${service.slug}`}
                                  data-lightbox-src={service.image.src}
                                  data-lightbox-alt={`${service.title} hizmet görseli`}
                                  aria-label={`${service.title} görselini büyüt`}
                                >
                                  <Image
                                    src={service.image}
                                    alt={`${service.title} hizmet görseli`}
                                    class="service-image-photo h-full w-full object-cover"
                                    width={1200}
                                    height={900}
                                    sizes="(max-width: 767px) 100vw, 50vw"
                                    loading="lazy"
                                  />
                                </button>
                              </div>
                            </div>
                          </div>

                          <div class={`relative space-y-5 ${index % 2 === 1 ? 'md:order-1' : ''}`}>
                            <div class="space-y-4">
                              <div class="flex flex-wrap items-center gap-2.5">
                                <span class="service-code-badge inline-flex items-center rounded-full border border-slate-200/90 bg-gradient-to-br from-white to-slate-50 px-3 py-1 text-xs md:text-sm font-semibold tracking-tight text-slate-700 shadow-sm ring-1 ring-slate-100">
                                  SRV-{service.id.padStart(2, '0')}
                                </span>
                              </div>
                              <h3 class="text-2xl md:text-3xl font-bold text-slate-900 service-title">
                                {service.title}
                              </h3>
                              <p class="text-base md:text-lg leading-relaxed text-slate-600">
                                {service.description}
                              </p>
                            </div>

                            <div class="service-meta-unified" role="group" aria-label="Hizmet özeti">
                              <div class="service-meta-slot">
                                <p class="service-meta-label">Kategori</p>
                                <p class="service-meta-value">{group.title}</p>
                              </div>
                              <div class="service-meta-divider" aria-hidden="true"></div>
                              <div class="service-meta-slot">
                                <p class="service-meta-label">Kapsam</p>
                                <p class="service-meta-value">{service.features.length} hizmet kalemi</p>
                              </div>
                            </div>

                            <div class="flex flex-wrap items-center gap-3 pt-1">
                              <a
                                href="/iletisim"
                                class="service-cta inline-flex min-h-[44px] items-center rounded-xl bg-accent-600 px-6 py-3 font-semibold text-white shadow-[0_12px_24px_rgba(176,60,36,0.25)] transition-[background-color,box-shadow,transform] duration-200 hover:bg-accent-700 hover:shadow-[0_14px_28px_rgba(176,60,36,0.32)] hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 active:translate-y-0"
                                aria-label={`${service.title} için teklif al`}
                              >
                                Bu hizmet için teklif al
                              </a>
                            </div>
                          </div>
                        </div>

                        <div class="space-y-3 border-t border-slate-200/80 pt-6">
                          <h4 class="text-base md:text-lg font-semibold text-slate-900 service-features-title">
                            Hizmet kapsamı
                          </h4>
                          <ul class="grid sm:grid-cols-2 gap-3 text-slate-700 service-features">
                            {service.features.map((feature, featureIndex) => (
                              <li
                                class="feature-item flex min-h-[44px] items-center gap-3 rounded-xl border border-slate-200/90 bg-white px-3 py-2.5 shadow-[0_1px_0_rgba(15,23,42,0.04)] ring-1 ring-slate-100/70"
                                style={`transition-delay: ${featureIndex * 70}ms`}
                              >
                                <span class="feature-check flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-50 ring-1 ring-accent-100/80" aria-hidden="true">
                                  <svg class="h-4 w-4 text-accent-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                  </svg>
                                </span>
                                <span class="text-sm font-medium leading-snug text-slate-700">{feature}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section bgColor="white">
    <div class="px-4 md:px-6 py-16 md:py-20">
      <div class="mx-auto max-w-6xl">
        <div class="text-center mb-10 animate-on-scroll">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">Çalışma sürecimiz</h2>
          <p class="mt-3 text-base md:text-lg text-gray-700 max-w-2xl mx-auto">
            Projelerinizi teknik doğruluk, net iletişim ve zamanında teslim odağı ile yönetiyoruz.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-5">
          {processSteps.map((step, index) => (
            <article
              class="step-item rounded-2xl border border-gray-200/90 bg-white p-6 shadow-sm ring-1 ring-gray-100/90 transition-[box-shadow,border-color] duration-200 hover:border-accent-200/70 hover:shadow-md"
              style={`transition-delay: ${index * 120}ms`}
            >
              <p class="text-sm font-semibold text-accent-700 mb-2">Adım {index + 1}</p>
              <h3 class="text-xl font-semibold text-gray-900 mb-3">{step.title}</h3>
              <p class="text-gray-700 leading-relaxed">{step.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </Section>

  <Section bgColor="gray-600" animate={true} animationType="scale">
    <div class="py-14 md:py-16 px-4 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
        Projeniz için profesyonel çözüm
      </h2>
      <p class="text-base md:text-lg text-neutral-100 mb-6 max-w-2xl mx-auto leading-relaxed">
        Hizmetlerimiz hakkında detaylı bilgi almak ve ücretsiz keşif planlamak için ekibimizle iletişime geçin.
      </p>
      <a
        href="/iletisim"
        class="inline-flex min-h-[44px] items-center rounded-lg bg-white px-8 py-3 font-semibold text-primary-700 transition-colors duration-200 hover:bg-gray-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-gray-600"
      >
        İletişime geç
      </a>
    </div>
  </Section>
</BaseLayout>

<style>
  .service-item,
  .step-item {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-item-accent {
    position: absolute;
    inset: 0 auto auto 0;
    height: 5px;
    width: 100%;
    background: linear-gradient(90deg, rgb(8 145 178), rgb(234 88 12));
    opacity: 0.95;
  }

  .service-meta-unified {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    border-radius: 1rem;
    border: 1px solid rgb(226 232 240 / 0.95);
    background: linear-gradient(135deg, rgb(248 250 252), rgb(255 255 255) 48%, rgb(254 251 249));
    padding: 0.9rem 1rem;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.9);
  }

  .service-meta-slot {
    flex: 1;
    min-width: 0;
  }

  .service-meta-label {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgb(100 116 139);
  }

  .service-meta-value {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: rgb(15 23 42);
    line-height: 1.35;
  }

  .service-meta-divider {
    display: none;
    width: 1px;
    align-self: stretch;
    background: linear-gradient(
      180deg,
      transparent,
      rgb(203 213 225),
      rgb(203 213 225),
      transparent
    );
  }

  @media (min-width: 480px) {
    .service-meta-unified {
      flex-direction: row;
      align-items: stretch;
      gap: 0;
      padding: 0.85rem 1rem;
    }

    .service-meta-slot {
      padding: 0.15rem 0.35rem;
    }

    .service-meta-divider {
      display: block;
      margin: 0 0.75rem;
      min-height: 2.75rem;
    }
  }

  .service-image-photo {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .service-item.animate-in,
  .step-item.animate-in {
    opacity: 1;
    transform: translateY(0);
  }

  .service-item.is-initial-visible,
  .service-item.is-initial-visible .service-image,
  .service-item.is-initial-visible .service-title,
  .service-item.is-initial-visible .service-features-title,
  .service-item.is-initial-visible .feature-item,
  .service-item.is-initial-visible .service-cta {
    opacity: 1;
    transform: none;
  }

  .service-image {
    opacity: 0;
    transform: translateY(6px) scale(0.98);
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-item.animate-in .service-image {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-item:is(:hover, :focus-within) .service-image-photo {
      transform: scale(1.03);
    }

    .feature-item {
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

    .feature-item:hover {
      border-color: rgb(239 207 203);
      background-color: rgb(255 255 255);
      box-shadow: 0 10px 22px rgb(15 23 42 / 0.06);
    }

    .group\/service:focus-within .service-image-photo {
      transform: scale(1.03);
    }
  }

  .service-title,
  .service-features-title,
  .feature-item,
  .service-cta {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-item.animate-in .service-title,
  .service-item.animate-in .service-features-title,
  .service-item.animate-in .feature-item,
  .service-item.animate-in .service-cta {
    opacity: 1;
    transform: translateY(0);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-item {
      transition: box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .service-item:hover {
      border-color: rgb(203 213 225);
      box-shadow: 0 18px 48px rgba(15, 23, 42, 0.09);
    }
  }

  .quick-nav-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 0.75rem;
    cursor: pointer;
    list-style: none;
    border-radius: 0.75rem;
  }

  .quick-nav-summary::-webkit-details-marker {
    display: none;
  }

  .quick-nav-accordion > .quick-nav-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
    opacity: 0;
  }

  .quick-nav-panel-content {
    overflow: hidden;
    transform: translateY(-2px);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .quick-nav-accordion[open] > .quick-nav-panel {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .quick-nav-accordion[open] .quick-nav-panel-content {
    transform: translateY(0);
  }

  .quick-nav-chevron {
    width: 1rem;
    height: 1rem;
    color: rgb(75 85 99);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .quick-nav-accordion[open] .quick-nav-chevron {
    transform: rotate(180deg);
    color: rgb(8 145 178);
  }

  .quick-nav-link {
    display: flex;
    align-items: center;
    min-height: 42px;
    border-radius: 0.65rem;
    border: 1px solid rgb(229 231 235);
    background: #fff;
    padding: 0.5rem 0.75rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: rgb(55 65 81);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .quick-nav-link:hover {
    border-color: rgb(14 116 144);
    color: rgb(14 116 144);
    background-color: rgb(248 250 252);
    box-shadow: 0 4px 14px rgba(14, 116, 144, 0.12);
  }

  .quick-nav-link.is-active {
    border-color: rgb(14 116 144);
    background-color: rgb(236 253 255);
    color: rgb(12 74 110);
    box-shadow: 0 4px 14px rgba(14, 116, 144, 0.16);
  }

  @media (min-width: 1024px) {
    .quick-nav-wrap {
      max-height: calc(100vh - 8rem);
      overflow: auto;
      padding-right: 0.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-item,
    .step-item,
    .service-image,
    .service-image-photo,
    .service-title,
    .service-features-title,
    .feature-item,
    .service-cta,
    .quick-nav-chevron,
    .quick-nav-panel,
    .quick-nav-panel-content {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  import { observeScrollAnimations } from '../presentation/utils/animations';
  import { initIsolatedImageLightbox } from '../presentation/utils/imageLightbox';

  function initAnimations() {
    observeScrollAnimations('.animate-on-scroll');
    observeScrollAnimations('.animate-fade');
    observeScrollAnimations('.animate-scale');

    const revealOnScroll = (selector: string) => {
      const elements = document.querySelectorAll(selector);
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const isAboveViewport = entry.boundingClientRect.top < 0;
          if (entry.isIntersecting || isAboveViewport) {
            entry.target.classList.add('animate-in');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -80px 0px' });

      elements.forEach((el) => {
        const rect = (el as HTMLElement).getBoundingClientRect();
        const alreadyPastViewport = rect.top < 0;
        const initiallyVisible = rect.top <= window.innerHeight - 80;

        if (alreadyPastViewport || initiallyVisible) {
          el.classList.add('animate-in');
          return;
        }

        observer.observe(el);
      });
    };

    revealOnScroll('.service-item:not(.is-initial-visible)');
    revealOnScroll('.step-item');

    const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-service-link]'));
    const serviceSections = Array.from(document.querySelectorAll<HTMLElement>('[data-service-section]'));
    const accordions = Array.from(document.querySelectorAll<HTMLDetailsElement>('.quick-nav-accordion'));

    const openAccordionByGroup = (groupId?: string) => {
      if (!groupId) return;
      accordions.forEach((accordion) => {
        accordion.open = accordion.dataset.groupId === groupId;
      });
    };

    const setActiveLink = (id: string) => {
      navLinks.forEach((link) => {
        link.classList.toggle('is-active', link.dataset.target === id);
      });

      const activeLink = navLinks.find((link) => link.dataset.target === id);
      if (activeLink) {
        openAccordionByGroup(activeLink.dataset.groupId);
      }
    };

    if (serviceSections.length && navLinks.length) {
      setActiveLink(serviceSections[0].id);
      const updateActiveFromScroll = () => {
        const viewportOffset = 180;
        let closestSection = serviceSections[0];
        let smallestDistance = Number.POSITIVE_INFINITY;

        serviceSections.forEach((section) => {
          const distance = Math.abs(section.getBoundingClientRect().top - viewportOffset);
          if (distance < smallestDistance) {
            smallestDistance = distance;
            closestSection = section;
          }
        });

        setActiveLink(closestSection.id);
      };

      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(() => {
          updateActiveFromScroll();
          ticking = false;
        });
      };

      navLinks.forEach((link) => {
        link.addEventListener('click', () => {
          const targetId = link.dataset.target;
          if (targetId) setActiveLink(targetId);
        });
      });

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      updateActiveFromScroll();
    }

    accordions.forEach((accordion) => {
      accordion.addEventListener('toggle', () => {
        if (!accordion.open) return;
        accordions.forEach((other) => {
          if (other !== accordion) other.open = false;
        });
      });
    });

    initIsolatedImageLightbox();
  }

  document.addEventListener('DOMContentLoaded', initAnimations);
  document.addEventListener('astro:page-load', initAnimations);
  initAnimations();
</script>
