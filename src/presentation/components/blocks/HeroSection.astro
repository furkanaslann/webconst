---
import Section from '../ui/Section.astro';
import { Swiper, SwiperWrapper, SwiperSlide, SwiperPagination, SwiperButtonPrev, SwiperButtonNext } from 'astro-swiper';
import { heroSlides } from '../../../core/constants/heroSlides';

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  cta2Text?: string;
  cta2Link?: string;
  bgImage?: boolean;
  enableSlider?: boolean;
  autoplayDelay?: number;
  showPagination?: boolean;
  showNavigation?: boolean;
}

const {
  title = 'Yapı Sektöründe Güvenilir Çözümler',
  subtitle = 'Güçlendirme, su yalıtım, zemin kaplama ve yapı kimyasalları alanında profesyonel hizmetler',
  ctaText = 'Teklif Al',
  ctaLink = '/iletisim',
  cta2Text = 'Hizmetlerimiz',
  cta2Link = '/hizmetler',
  bgImage = true,
  enableSlider = false,
  autoplayDelay = 5000,
  showPagination = true,
  showNavigation = true,
} = Astro.props;
---

<Section className="py-20 md:py-32">
  <div class="container mx-auto px-4 text-center">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6 leading-tight">
        {title}
      </h1>
      <p class="text-xl text-gray-600 mb-10 max-w-2xl mx-auto">
        {subtitle}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={ctaLink}
          class="inline-block bg-accent-500 text-white px-8 py-4 rounded-lg font-medium hover:bg-accent-600 transition-colors shadow-lg"
        >
          {ctaText}
        </a>
        <a
          href={cta2Link}
          class="inline-block bg-white text-primary-700 px-8 py-4 rounded-lg font-medium hover:bg-gray-50 transition-colors border-2 border-primary-200"
        >
          {cta2Text}
        </a>
      </div>
    </div>

    {bgImage && !enableSlider && (
      <div class="mt-16 relative">
        <div class="aspect-video bg-gradient-to-br from-secondary-100 via-neutral-100 to-accent-100 rounded-2xl flex items-center justify-center overflow-hidden">
          <div class="text-center p-8">
            <svg class="w-32 h-32 text-primary-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
            <p class="text-primary-600 font-medium">20+ Yıllık Tecrübe</p>
            <p class="text-gray-500 mt-2">Kayseri ve çevresinde profesyonel hizmet</p>
          </div>
        </div>
      </div>
    )}

    {bgImage && enableSlider && (
      <div class="mt-16 relative">
        <Swiper
          options={{
            loop: true,
            autoplay: {
              delay: autoplayDelay,
              disableOnInteraction: false,
              pauseOnMouseEnter: false,
              waitForTransition: false,
            },
            pagination: showPagination ? {
              el: '.swiper-pagination',
              clickable: true,
            } : undefined,
            navigation: showNavigation ? {
              nextEl: '.swiper-button-next',
              prevEl: '.swiper-button-prev',
            } : undefined,
            effect: 'fade',
            fadeEffect: {
              crossFade: true,
            },
            speed: 650,
          }}
          class="hero-swiper"
          data-autoplay-delay={autoplayDelay}
          aria-live="polite"
          aria-label="Öne çıkan hizmet görselleri"
        >
          <SwiperWrapper>
            {heroSlides.map((slide, index) => (
              <SwiperSlide>
                <div class="aspect-[4/3] sm:aspect-[16/10] lg:aspect-video bg-gradient-to-br from-secondary-100 via-neutral-100 to-accent-100 rounded-2xl flex items-center justify-center overflow-hidden relative">
                  <!-- Background Görsel -->
                  <img
                    src={slide.image}
                    alt={slide.title}
                    class="absolute inset-0 w-full h-full object-cover"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : 'auto'}
                  />
                  <!-- Gradient Overlay -->
                  <div class="absolute inset-0 bg-gradient-to-br from-black/60 via-black/35 to-black/50"></div>
                  <!-- Üzerinde Kart İçeriği -->
                  <div class="hero-slide-card absolute left-1/2 top-1/2 w-[calc(100%-2rem)] sm:w-[calc(100%-2rem)] max-w-[32rem] sm:max-w-[36rem] -translate-x-1/2 -translate-y-1/2 text-left p-3 sm:p-5 lg:p-7 rounded-2xl">
                    <p class="hero-slide-kicker mb-1.5 sm:mb-2 text-[10px] sm:text-xs font-semibold uppercase tracking-[0.12em] sm:tracking-[0.14em] text-accent-600">Uzman Uygulama</p>
                    <h3 class="hero-slide-title text-lg sm:text-xl lg:text-4xl font-bold text-slate-950 mb-2 sm:mb-3">{slide.title}</h3>
                    <p class="hero-slide-description hidden sm:block text-slate-700 text-sm lg:text-base leading-relaxed line-clamp-2 lg:line-clamp-none">{slide.description}</p>
                    <div class="mt-2 sm:mt-4 flex flex-wrap items-center gap-1.5 sm:gap-2">
                      <span class="inline-flex min-h-[30px] sm:min-h-[32px] items-center rounded-full border border-accent-200 bg-accent-50 px-2.5 sm:px-3 text-[11px] sm:text-xs font-semibold text-accent-800">20+ Yıl Tecrübe</span>
                      <span class="inline-flex min-h-[30px] sm:min-h-[32px] items-center rounded-full border border-slate-200 bg-white px-2.5 sm:px-3 text-[11px] sm:text-xs font-semibold text-slate-700">500+ Proje</span>
                    </div>
                    <a
                      href={slide.ctaLink ?? cta2Link}
                      class="mt-2.5 sm:mt-5 inline-flex w-full sm:w-auto justify-center min-h-[40px] sm:min-h-[44px] items-center rounded-lg bg-accent-600 px-4 sm:px-5 py-2 text-sm font-semibold text-white transition-colors duration-200 hover:bg-accent-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-700 focus-visible:ring-offset-2 cursor-pointer"
                    >
                      {slide.ctaText ?? cta2Text}
                    </a>
                  </div>
                </div>
              </SwiperSlide>
            ))}
          </SwiperWrapper>

          {showPagination && <SwiperPagination class="!bottom-4" />}
          {showNavigation && (
            <>
              <SwiperButtonPrev class="!text-white !hidden lg:!flex" />
              <SwiperButtonNext class="!text-white !hidden lg:!flex" />
            </>
          )}
        </Swiper>
        <div class="hero-progress" aria-hidden="true">
          <span class="hero-progress-bar"></span>
        </div>
      </div>
    )}
  </div>
</Section>

<style>
  :global(.hero-swiper .swiper-pagination-bullet) {
    background: rgba(255, 255, 255, 0.5);
    opacity: 1;
  }
  :global(.hero-swiper .swiper-pagination-bullet-active) {
    background: white;
  }
  :global(.hero-swiper .swiper-button-prev),
  :global(.hero-swiper .swiper-button-next) {
    min-width: 44px;
    min-height: 44px;
    border-radius: 9999px;
    backdrop-filter: blur(2px);
  }
  :global(.hero-swiper .swiper-button-prev:after),
  :global(.hero-swiper .swiper-button-next:after) {
    font-size: 16px;
  }

  /* Slide Card Animations */
  .hero-slide-card {
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.75);
    box-shadow: 0 16px 45px rgba(15, 23, 42, 0.28);
    backdrop-filter: blur(4px);
    opacity: 0;
  }

  @media (max-width: 767px) {
    .hero-slide-card {
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.24);
      backdrop-filter: blur(2px);
    }
  }

  .hero-slide-card.animate {
    animation: slideCardFadeIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slideCardFadeIn {
    to {
      opacity: 1;
    }
  }

  .hero-slide-title {
    opacity: 0;
    transform: translateY(15px);
  }

  .hero-slide-card.animate .hero-slide-title {
    animation: slideTitleFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }

  @keyframes slideTitleFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-slide-description {
    opacity: 0;
    transform: translateY(15px);
  }

  .hero-slide-card.animate .hero-slide-description {
    animation: slideDescFadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
  }

  .hero-slide-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(248, 250, 252, 0.88));
    z-index: -1;
  }

  @keyframes slideDescFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-progress {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.75rem;
    z-index: 15;
    height: 4px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.35);
    overflow: hidden;
  }

  .hero-progress-bar {
    display: block;
    width: 0%;
    height: 100%;
    border-radius: inherit;
    background: white;
    transition: width 120ms linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide-card,
    .hero-slide-title,
    .hero-slide-description {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
      transition: none !important;
    }

    .hero-progress-bar {
      transition: none !important;
    }
  }
</style>

<script>
  function initSlideAnimations() {
    const swiper = document.querySelector('.hero-swiper') as HTMLElement | null;
    if (!swiper) return;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const progressBar = document.querySelector('.hero-progress-bar') as HTMLElement | null;
    const autoplayDelayValue = Number(swiper.getAttribute('data-autoplay-delay')) || 5000;
    let progressTimer: number | null = null;
    let progressStart = 0;
    const isPaused = reduceMotion;

    const animateActiveSlide = () => {
      // Remove animation from all cards
      swiper.querySelectorAll('.hero-slide-card').forEach((card) => {
        card.classList.remove('animate');
      });

      // Add animation to active slide card
      const activeCard = swiper.querySelector('.swiper-slide-active .hero-slide-card');
      if (activeCard) {
        // Force reflow to restart animation
        void (activeCard as HTMLElement).offsetWidth;
        if (!reduceMotion) {
          activeCard.classList.add('animate');
        } else {
          activeCard.classList.remove('animate');
        }
      }
    };

    const stopProgress = () => {
      if (progressTimer) {
        window.cancelAnimationFrame(progressTimer);
        progressTimer = null;
      }
    };

    const startProgress = () => {
      if (!progressBar) return;
      stopProgress();
      progressBar.style.width = '0%';
      if (isPaused || reduceMotion) return;
      progressStart = performance.now();

      const tick = (now: number) => {
        const elapsed = now - progressStart;
        const percent = Math.min((elapsed / autoplayDelayValue) * 100, 100);
        progressBar.style.width = `${percent}%`;
        if (percent < 100 && !isPaused) {
          progressTimer = window.requestAnimationFrame(tick);
        }
      };

      progressTimer = window.requestAnimationFrame(tick);
    };

    // Initial animation
    setTimeout(animateActiveSlide, 100);
    startProgress();

    // Watch for slide changes
    const observer = new MutationObserver(() => {
      animateActiveSlide();
      startProgress();
    });

    // Observe slide class changes
    swiper.querySelectorAll('.swiper-slide').forEach((slide) => {
      observer.observe(slide, { attributes: true, attributeFilter: ['class'] });
    });
  }

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', initSlideAnimations);
  // Fallback for Astro's page load
  initSlideAnimations();
</script>
