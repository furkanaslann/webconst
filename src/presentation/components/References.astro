---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Reference {
  id: string;
  title: string;
  location: string;
  year: string;
  category: string;
  description: string;
  image?: ImageMetadata;
}

interface Props {
  references: Reference[];
}

const { references } = Astro.props;

/** Türkçe harfler ASCII slug ile eşleşsin (örn. `ı` regex'te [a-z] dışında kalırdı). */
const asciiFoldTr = (s: string) =>
  s
    .replace(/ğ/g, 'g')
    .replace(/ü/g, 'u')
    .replace(/ş/g, 's')
    .replace(/ı/g, 'i')
    .replace(/ö/g, 'o')
    .replace(/ç/g, 'c');

const slugifyCategory = (category: string) =>
  asciiFoldTr(category.toLocaleLowerCase('tr-TR'))
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
---

<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
  {references.map((ref, index) => (
    <article
      class="reference-card-shell group bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden"
      style={`--reveal-delay: ${index * 90}ms`}
      data-category={slugifyCategory(ref.category)}
      data-reference-card
    >
      <div class="reference-card-lift">
        <div class="aspect-video bg-gradient-to-br from-secondary-100 via-neutral-100 to-accent-100 flex items-center justify-center relative overflow-hidden reference-image">
        {ref.image ? (
          <Image
            src={ref.image}
            alt={ref.title}
            class="h-full w-full object-cover"
            sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw"
            loading="lazy"
            width={1200}
            height={800}
          />
        ) : (
          <div class="text-center p-6">
            <svg class="w-16 h-16 text-primary-400 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
            <p class="text-sm text-primary-600 font-medium">{ref.category}</p>
          </div>
        )}
        <div class="absolute top-4 right-4 bg-accent-500 text-white px-3 py-1 rounded-full text-sm font-medium">
          {ref.year}
        </div>
        </div>
        <div class="p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-2 leading-snug">{ref.title}</h3>
          <div class="flex items-center text-sm text-gray-500 mb-3">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            {ref.location}
          </div>
          <p class="text-gray-600 text-sm leading-6">{ref.description}</p>
        </div>
      </div>
    </article>
  ))}
</div>

<style>
  /* Shell: liste animasyonunda sadece opaklık geciktirilir; gölge hover’da hep gecikmesiz tween olur */
  .reference-card-shell {
    opacity: 0;
    transition:
      opacity 0.55s cubic-bezier(0.4, 0, 0.2, 1) var(--reveal-delay, 0ms),
      box-shadow 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      border-color 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .reference-card-shell.animate-in-shell {
    opacity: 1;
  }

  .reference-card-shell:hover {
    box-shadow:
      0 20px 25px -5px rgb(0 0 0 / 0.07),
      0 10px 10px -5px rgb(0 0 0 / 0.04);
    border-color: rgb(229 231 235);
  }

  /* İç blok: ilk görünümde süre+gating animation-delay ile kayar; hover transform’da gecikme yok → akıcı */
  .reference-card-lift {
    transform: translate3d(0, 28px, 0);
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .reference-card-shell.animate-in-shell .reference-card-lift {
    animation: reference-card-rise 0.72s cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0ms)
      forwards;
  }

  /** Yükseliş animation’ından sonra tween’leri transition’a al; hover hep gecikmesiz akar */
  .reference-card-lift.after-rise {
    animation: none;
    transform: translate3d(0, 0, 0);
  }

  .reference-card-shell.group:hover .reference-card-lift.after-rise {
    transform: translate3d(0, -6px, 0);
  }

  @keyframes reference-card-rise {
    from {
      transform: translate3d(0, 28px, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  .reference-image {
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .reference-card-shell.animate-in-shell .reference-image {
    opacity: 1;
    transition-delay: 0.15s;
  }

  @media (prefers-reduced-motion: reduce) {
    .reference-card-shell {
      opacity: 1 !important;
    }

    .reference-card-shell {
      transition: none !important;
    }

    .reference-image {
      opacity: 1 !important;
      transition: none !important;
    }

    .reference-card-lift {
      animation: none !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function parseCssTimeMs(value: string): number {
    const v = value.trim();
    if (!v) return 0;
    const num = Number.parseFloat(v);
    if (Number.isNaN(num)) return 0;
    if (v.endsWith('ms')) return num;
    if (v.endsWith('s')) return num * 1000;
    return num;
  }

  function initReferenceAnimations() {
    const cards = document.querySelectorAll('.reference-card-shell');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        const shell = entry.target;
        if (!(shell instanceof HTMLElement)) return;

        shell.classList.add('animate-in-shell');
        observer.unobserve(shell);

        const lift = shell.querySelector('.reference-card-lift');
        if (!(lift instanceof HTMLElement)) return;

        const delayMs = parseCssTimeMs(getComputedStyle(shell).getPropertyValue('--reveal-delay'));

        /** `0.72s` → ms (animation sırasından bağımsız, sabit yükseliş süresi ile eşlenir) */
        const fallbackMs = parseCssTimeMs(getComputedStyle(lift).animationDuration) || 720;

        /** Animation bittikten sonra transition ile hover’a geçilir (gecikmesiz tween) */
        const handleAnimationEnd = (event: AnimationEvent) => {
          if (event.animationName !== 'reference-card-rise' || event.target !== lift) return;
          lift.classList.add('after-rise');
          lift.removeEventListener('animationend', handleAnimationEnd);
        };

        lift.addEventListener('animationend', handleAnimationEnd);
        window.setTimeout(() => {
          lift.classList.add('after-rise');
          lift.removeEventListener('animationend', handleAnimationEnd);
        }, delayMs + fallbackMs + 80);
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

    cards.forEach((card) => observer.observe(card));
  }

  document.addEventListener('DOMContentLoaded', initReferenceAnimations);
  initReferenceAnimations();
</script>
