---
import complogo from '../../../public/images/complogotrans.png';

const normalizePath = (path: string) =>
  path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;

const currentPath = normalizePath(Astro.url.pathname);

const navItems = [
  { href: '/', label: 'Anasayfa' },
  { href: '/hizmetler', label: 'Hizmetler' },
  { href: '/referanslar', label: 'Referanslar' },
  { href: '/sss', label: 'SSS' },
  { href: '/hakkimizda', label: 'Hakkımızda' },
  { href: '/iletisim', label: 'İletişim' },
];
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center" aria-label="Process ana sayfa">
        <img
          src={complogo.src}
          alt="Process logo"
          class="h-12 md:h-14 w-auto object-contain"
          loading="eager"
          decoding="async"
        />
      </a>

      <div class="hidden lg:flex space-x-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`font-medium transition-colors ${
              currentPath === normalizePath(item.href)
                ? 'text-accent-600'
                : 'text-gray-700 hover:text-accent-600'
            }`}
          >
            {item.label}
          </a>
        ))}
      </div>

      <div class="hidden lg:block">
        <a
          href="/iletisim"
          class="inline-block bg-accent-500 text-white px-6 py-2 rounded-lg font-medium hover:bg-accent-600 transition-colors"
        >
          Teklif Al
        </a>
      </div>

      <button
        id="mobile-menu-button"
        class="lg:hidden p-2 rounded-lg hover:bg-gray-100"
        aria-label="Menüyü aç"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width={2}
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden mt-4 pb-4">
      <div class="flex flex-col space-y-3">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`font-medium py-2 transition-colors ${
              currentPath === normalizePath(item.href)
                ? 'text-accent-600'
                : 'text-gray-700 hover:text-accent-600'
            }`}
          >
            {item.label}
          </a>
        ))}
        <a
          href="/iletisim"
          class="inline-block bg-accent-500 text-white px-6 py-2 rounded-lg font-medium hover:bg-accent-600 transition-colors text-center"
        >
          Teklif Al
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
